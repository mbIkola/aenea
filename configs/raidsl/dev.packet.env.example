# Явный dev-профиль Packet; ссылка соответствует сохранённому пользователем ключу.
AENEA_ENV=dev
RAIDSL_PROVIDER=packet
RAIDSL_BASE_URL=https://api.packet.ai/v1
RAIDSL_MODEL=nvidia-deepseek-v4-1-flash-nvfp4
RAIDSL_API_KEY=pass://aenea/deepseek/api_key
RAIDSL_MAX_TURNS=5
RAIDSL_MAX_OUTPUT_TOKENS=2048
RAIDSL_TIMEOUT_SECONDS=60
