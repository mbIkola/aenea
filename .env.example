# Aenea dev: только Proton Pass ссылки и несекретные настройки.
# Не заменять ссылки значениями секретов. Заполнить поля в vault aenea.
# Наличие и доступность item/полей не проверялись; часть сервисов ещё не создана.
# Scaffold не загружает этот файл и не подключается к сервисам.
AENEA_ENV=dev
AENEA_SQLITE_PATH=runtime/aenea.dev.sqlite3

# Hosted Langfuse: один проект, его реальный адрес и парные API-ключи.
LANGFUSE_BASE_URL=pass://aenea/langfuse/base_url
LANGFUSE_PUBLIC_KEY=pass://aenea/langfuse/public_key
LANGFUSE_SECRET_KEY=pass://aenea/langfuse/secret

# Зарезервировано: OpenAI ещё не подготовлен.
OPENAI_API_KEY=pass://aenea/openai/api_key

# Telegram Reader использует отдельные профили configs/telegram/*.env.example.
# Здесь — ссылки для первого входа; сессия создаётся явной командой login.
TELEGRAM_API_ID=pass://aenea/telegram/api_id
TELEGRAM_API_HASH=pass://aenea/telegram/api_hash
TELEGRAM_PHONE=pass://aenea/telegram/phone

# Telegram-сессия: способ защищённого хранения определить перед первым входом.
